{
  "name": "@local/dsh-version-badge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Show the DJH four-part version number (0.000.0.0, little-DJ convention) to the right of the settings button in the sidebar footer.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
