{
  "name": "@local/dsh-model-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "模型中心：全网模型 API 比价扫描 + 供应商 Key 管理",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
