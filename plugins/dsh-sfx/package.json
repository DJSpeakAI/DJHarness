{
  "name": "@local/dsh-sfx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "设置→音效：大管家回复结束 / 向你提问的提示音（移植自 little DJ，WebAudio 合成）",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-ui-settings-general"]
    }
  }
}
